#: core/serializers.py:13
msgid "This transaction belongs to a transfer: edit the transfer instead."
msgstr ""
"Questo movimento fa parte di un trasferimento: modifica il trasferimento."

#: core/serializers.py:14
msgid "This recurring transaction has ended."
msgstr "Questo movimento ricorrente è terminato."

#: core/serializers.py:71
msgid "A personal wallet has exactly one owner."
msgstr "Un portafoglio personale ha un solo titolare."

#: core/serializers.py:85
msgid "This name is already in use."
msgstr "Questo nome è già utilizzato."

#: core/serializers.py:116
msgid "This category already has a budget in this currency."
msgstr "Questa categoria ha già un budget in questa valuta."

#: core/serializers.py:136
msgid "This currency already has a family contribution."
msgstr "Questa valuta ha già un contributo familiare."

#: core/serializers.py:151 core/serializers.py:291 core/transactions_csv.py:199
msgid "This wallet is archived."
msgstr "Questo portafoglio è archiviato."

#: core/serializers.py:156 core/transactions_csv.py:65
msgid "The amount cannot be zero."
msgstr "L'importo non può essere zero."

#: core/serializers.py:233 core/serializers.py:347
msgid "The end date cannot precede the start date."
msgstr "La data di fine non può precedere la data di inizio."

#: core/serializers.py:293
msgid "Choose a wallet different from the source one."
msgstr "Scegli un portafoglio diverso da quello di origine."

#: core/serializers.py:295
msgid "The wallets must use the same currency."
msgstr "I portafogli devono usare la stessa valuta."

#: core/serializers.py:397
msgid "You cannot change this on your own account."
msgstr "Non puoi modificare questo campo sul tuo account."

#: core/serializers.py:449
msgid "Invalid email or password."
msgstr "Email o password non valide."

#: core/transactions_csv.py:58
msgid "A transfer has no category and no tags."
msgstr "Un trasferimento non ha categoria né tag."

#: core/transactions_csv.py:60
msgid "A transfer cannot be a shared expense."
msgstr "Un trasferimento non può essere una spesa comune."

#: core/transactions_csv.py:73
#, python-format
msgid "Ensure every tag has no more than %(max_length)d characters."
msgstr "Assicurati che ogni tag non abbia più di %(max_length)d caratteri."

#: core/transactions_csv.py:118
msgid "The file must be a CSV encoded in UTF-8."
msgstr "Il file deve essere un CSV con codifica UTF-8."

#: core/transactions_csv.py:123
#, python-format
msgid "Missing columns: %(columns)s."
msgstr "Colonne mancanti: %(columns)s."

#: core/transactions_csv.py:127
msgid "The file contains no transactions."
msgstr "Il file non contiene movimenti."

#: core/transactions_csv.py:133
#, python-format
msgid "Row %(number)d, %(field)s: %(message)s"
msgstr "Riga %(number)d, %(field)s: %(message)s"

#: core/transactions_csv.py:162
msgid "A transfer needs exactly two rows."
msgstr "Un trasferimento richiede esattamente due righe."

#: core/transactions_csv.py:170
msgid ""
"The rows of a transfer need opposite amounts, the same date and different "
"wallets with the same currency."
msgstr ""
"Le righe di un trasferimento richiedono importi opposti, la stessa data e "
"portafogli diversi con la stessa valuta."

#: core/transactions_csv.py:195
msgid "More than one wallet has this name."
msgstr "Più di un portafoglio ha questo nome."

#: core/transactions_csv.py:202
#, python-format
msgid "The wallet uses %(currency)s."
msgstr "Il portafoglio usa %(currency)s."

#: core/views.py:133
msgid "You cannot delete your own account."
msgstr "Non puoi eliminare il tuo account."

